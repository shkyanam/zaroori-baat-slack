ZAROORI_BAAT_SLACK_PORT=8001
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
SLACK_BOT_TOKEN=replace-with-slack-bot-token
SLACK_CHANNEL_IDS=C0BTKCAJYA1,C0BTKCB0E4D
SLACK_SYNC_LIMIT=20
# Keep live Slack ingestion fast; use Refresh context for optional full enrichment.
SLACK_FAST_PATH=true
# Optional hybrid RAG. Uses an OpenAI-compatible /embeddings endpoint and stores vectors locally in SQLite.
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=replace-with-embedding-model
# RAG_API_KEY=replace-with-embedding-api-key
# RAG_BASE_URL=https://your-openai-compatible-endpoint/v1
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.35
# Keep false so live Slack messages retain the deterministic few-second fast path.
RAG_ON_FAST_PATH=false
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=slack-message-intelligence-eval
LANGSMITH_CAPTURE_CONTENT=false
SMI_DATASET_VERSION=v1
SMI_MODEL_PROVIDER=Nebius
SMI_MODEL_NAME=replace-with-nebius-model
SMI_PROMPT_VERSION=signal-context-v1
SMI_WORKFLOW_VERSION=workflow-v1
SMI_EVALUATOR_VERSION=eval-v1
SMI_ESCALATION_PROBABILITY_TOLERANCE=0.10
SMI_LATENCY_SLO_SECONDS=5.0
