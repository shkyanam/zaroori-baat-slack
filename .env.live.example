# Copy to .env.live.local. The local file is ignored by Git.
# Use the existing Slack app's bot token; never place it in a VITE_ variable.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
SLACK_SIGNING_SECRET=

# A separate local database prevents demo data from entering this workspace.
ZAROORI_BAAT_SLACK_HOST=127.0.0.1
ZAROORI_BAAT_SLACK_PORT=8002
ZAROORI_BAAT_DATABASE_PATH=.runtime/live/messages.sqlite3
LANGGRAPH_CHECKPOINT_PATH=.runtime/live/checkpoints.sqlite3
ZAROORI_BAAT_SEED_DEMO=false

# Optional services can be configured here separately when needed.
LLM_CONTEXT_ENABLED=false
MEM0_ENABLED=false
LANGSMITH_TRACING=false
